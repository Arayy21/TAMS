        <mxCell id="title" value="ENTITY RELATIONSHIP DIAGRAM — TAMS&#xa;Skema tabel dan foreign key sesuai migration aplikasi" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="1000" height="70" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legenda: PK = primary key · FK = foreign key · NULL = nullable · UQ = unique · Garis relasi menghubungkan FK ke PK (crow's foot = banyak). Aksi ON DELETE dicantumkan pada kolom FK." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="95" width="1500" height="45" as="geometry" />
        </mxCell>

        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;br&gt;PK id : bigint&lt;br&gt;name : varchar(100)&lt;br&gt;UQ email : varchar(150)&lt;br&gt;email_verified_at : timestamp NULL&lt;br&gt;password : varchar&lt;br&gt;role : enum(admin, pengelola, staff)&lt;br&gt;is_active : boolean (default true)&lt;br&gt;must_change_password : boolean (default false)&lt;br&gt;session_version : unsigned int (default 0)&lt;br&gt;last_login_at : timestamp NULL&lt;br&gt;remember_token : varchar NULL&lt;br&gt;created_at, updated_at : timestamps" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;overflow=hidden;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;lineHeight=1.35;" vertex="1" parent="1">
