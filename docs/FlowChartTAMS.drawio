        <mxCell id="b" value="Masukkan email dan kata sandi&#xa;(opsional: ingat saya)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1"><mxGeometry x="590" y="225" width="300" height="80" as="geometry" /></mxCell>
