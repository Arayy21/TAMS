        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\r\n    operator[/\&quot;Admin / Pengelola / Staff\&quot;/]\r\n\r\n    subgraph system[\&quot;Sistem TAMS\&quot;]\r\n        access((1. Autentikasi dan hak akses))\r\n        inventory((2. Kelola inventaris))\r\n        loan((3. Kelola peminjaman))\r\n        stock((4. Mutasi dan stok opname))\r\n        report((5. Dashboard dan laporan))\r\n    end\r\n\r\n    d_users[(D1 Pengguna)]\r\n    d_catalog[(D2 Kategori dan lokasi)]\r\n    d_assets[(D3 Aset)]\r\n    d_loans[(D4 Peminjaman)]\r\n    d_stock[(D5 Mutasi stok)]\r\n    d_opname[(D6 Sesi dan item opname)]\r\n    d_history[(D7 Riwayat aset)]\r\n\r\n    operator --&gt;|Kredensial dan request| access\r\n    access --&gt;|Validasi akun / sesi| d_users\r\n    d_users --&gt;|Akun dan peran| access\r\n    access --&gt;|Akses terotorisasi| inventory\r\n    access --&gt;|Akses terotorisasi| loan\r\n    access --&gt;|Akses terotorisasi| stock\r\n    access --&gt;|Akses terotorisasi| report\r\n\r\n    operator --&gt;|Data aset, kategori, lokasi, barcode| inventory\r\n    inventory --&gt;|Baca / tulis| d_catalog\r\n    d_catalog --&gt;|Referensi kategori dan lokasi| inventory\r\n    inventory --&gt;|Baca / tulis aset| d_assets\r\n    inventory --&gt;|Catat perubahan aset| d_history\r\n    d_assets --&gt;|Data aset| inventory\r\n\r\n    operator --&gt;|Data peminjaman dan pengembalian| loan\r\n    loan --&gt;|Cek aset dan ketersediaan| d_assets\r\n    loan --&gt;|Baca / tulis pinjaman| d_loans\r\n    d_loans --&gt;|Status pinjaman aktif / terlambat| loan\r\n\r\n    operator --&gt;|Transaksi masuk / keluar dan hasil hitung| stock\r\n    stock --&gt;|Baca / sesuaikan jumlah dan kondisi| d_assets\r\n    stock --&gt;|Baca / tulis mutasi| d_stock\r\n    stock --&gt;|Baca / tulis sesi dan item| d_opname\r\n    stock --&gt;|Catat penyesuaian| d_history\r\n\r\n    report --&gt;|Baca ringkasan| d_assets\r\n    report --&gt;|Baca| d_loans\r\n    report --&gt;|Baca| d_stock\r\n    report --&gt;|Baca| d_opname\r\n    report --&gt;|Baca| d_history\r\n    report --&gt;|Dashboard, laporan, ekspor| operator&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="dPLZ_MVl1UrV0MtDhF8Z-1">
