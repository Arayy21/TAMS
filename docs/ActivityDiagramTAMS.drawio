          <mxGeometry x="440" y="790" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="disabled" value="Logout otomatis, invalidasi sesi,&#xa;tampilkan pesan akun nonaktif" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" vertex="1" parent="1">
