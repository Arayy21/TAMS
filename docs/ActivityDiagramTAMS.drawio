        <mxCell id="title" value="ACTIVITY DIAGRAM - SISTEM MANAJEMEN ASET TAMS&#xa;Alur umum pengguna, akses berbasis peran, dan proses seluruh modul utama" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;fontStyle=1;fontColor=#16324F;" vertex="1" parent="1">
