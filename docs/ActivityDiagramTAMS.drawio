        </mxCell>
        <mxCell id="role" value="Peran Admin /&#xa;Pengelola?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="470" y="960" width="180" height="105" as="geometry" />
        </mxCell>
        <mxCell id="admin-home" value="Beranda Admin&#xa;Dashboard dan menu administrasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="300" y="1120" width="250" height="70" as="geometry" />
        </mxCell>
        <mxCell id="staff-home" value="Beranda Pengguna&#xa;Daftar aset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="590" y="1120" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="menu" value="Pilih fitur&#xa;(akses diperiksa pada setiap request)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1090" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="asset" value="ASET, BARCODE &amp; PEMINDAIAN&#xa;Daftar / cari / filter aset; tambah, ubah, arsipkan&#xa;Validasi data, jumlah, kategori dan lokasi&#xa;Simpan riwayat perubahan&#xa;Cetak barcode/label; scan kode dan buka detail aset&#xa;Pengguna: Admin, Pengelola, Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1350" width="570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="loan" value="PEMINJAMAN &amp; PENGEMBALIAN&#xa;Isi peminjam, aset, jumlah dan tanggal&#xa;Validasi aset aktif/kondisi baik, stok tersedia, dan tanggal&#xa;Simpan pinjaman; tampilkan peringatan jika ada pinjaman terlambat&#xa;Saat kembali: validasi tanggal lalu catat tanggal pengembalian&#xa;Pengguna: Admin, Pengelola, Staff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="1350" width="570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="profile" value="PROFIL PENGGUNA&#xa;Lihat dan ubah nama profil&#xa;Ubah kata sandi dengan validasi kata sandi saat ini&#xa;Simpan perubahan atau tampilkan kesalahan validasi&#xa;Pengguna: semua akun yang aktif" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1350" width="570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="users" value="PENGELOLAAN PENGGUNA&#xa;Admin mencari, membuat, mengubah, menonaktifkan, atau menghapus akun&#xa;Validasi email, peran, kata sandi dan konfirmasi&#xa;Cegah hapus/nonaktif akun sendiri dan pertahankan Admin aktif&#xa;Akses di luar izin ditolak (403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1350" width="570" height="180" as="geometry" />
        </mxCell>
        <mxCell id="master" value="KATEGORI &amp; LOKASI&#xa;Admin menambah, mengubah, atau menghapus data master&#xa;Validasi nama unik, relasi lokasi induk, dan foto lokasi&#xa;Tolak penghapusan jika masih dipakai aset / memiliki sublokasi&#xa;Akses di luar izin ditolak (403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="1590" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="opname" value="STOK OPNAME&#xa;Admin membuat sesi untuk lokasi atau seluruh aset aktif&#xa;Catat jumlah dan kondisi fisik setiap aset; hitung selisih&#xa;Selesaikan sesi: terapkan penyesuaian stok/kondisi atau simpan hasil saja&#xa;Catat riwayat; tandai item yang perlu ditinjau manual" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="670" y="1590" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="movement" value="MUTASI STOK&#xa;Admin mencatat barang masuk (pembelian) atau keluar (rusak/dibuang)&#xa;Validasi jumlah, tanggal, alasan dan stok tersedia&#xa;Perbarui stok dalam transaksi; sesuaikan status jika stok habis/masuk kembali&#xa;Simpan riwayat aset dan transaksi mutasi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1280" y="1590" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="reports" value="RIWAYAT &amp; LAPORAN&#xa;Admin melihat riwayat aset dan memfilter aktivitas&#xa;Pilih laporan aset, peminjaman, opname, atau mutasi&#xa;Validasi filter dan tanggal; tampilkan/cetak atau ekspor PDF, Word, Excel, CSV&#xa;Akses di luar izin ditolak (403)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" vertex="1" parent="1">
          <mxGeometry x="1890" y="1590" width="570" height="170" as="geometry" />
        </mxCell>
        <mxCell id="logout" value="Pilih keluar&#xa;Logout, invalidasi sesi, regenerasi token" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1110" y="1830" width="300" height="75" as="geometry" />
