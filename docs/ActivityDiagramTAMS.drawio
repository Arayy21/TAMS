        <mxCell id="note" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=18;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;spacingLeft=10;" value="Catatan: fitur admin dibatasi middleware peran/izin; percobaan login dibatasi. Kesalahan validasi ditampilkan ke pengguna tanpa menyimpan perubahan. Setelah menyelesaikan fitur, pengguna dapat kembali ke menu dan memilih fitur lain." vertex="1">
