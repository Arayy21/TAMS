        </mxCell>
        <mxCell id="admin-home" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" value="Beranda Admin&#xa;Dashboard dan menu administrasi" vertex="1">
          <mxGeometry height="70" width="250" x="300" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="staff-home" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" value="Beranda Pengguna&#xa;Daftar aset" vertex="1">
          <mxGeometry height="70" width="220" x="590" y="1120" as="geometry" />
        </mxCell>
        <mxCell id="menu" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;" value="Pilih fitur&#xa;(akses diperiksa pada setiap request)" vertex="1">
          <mxGeometry height="120" width="250" x="1040" y="1090" as="geometry" />
        </mxCell>
        <mxCell id="asset" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="ASET, BARCODE &amp; PEMINDAIAN&#xa;Daftar / cari / filter aset; tambah, ubah, arsipkan&#xa;Validasi data, jumlah, kategori dan lokasi&#xa;Simpan riwayat perubahan&#xa;Cetak barcode/label; scan kode dan buka detail aset&#xa;Pengguna: Admin, Pengelola, Staff" vertex="1">
          <mxGeometry height="180" width="570" x="60" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="loan" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="PEMINJAMAN &amp; PENGEMBALIAN&#xa;Isi peminjam, aset, jumlah dan tanggal&#xa;Validasi aset aktif/kondisi baik, stok tersedia, dan tanggal&#xa;Simpan pinjaman; tampilkan peringatan jika ada pinjaman terlambat&#xa;Saat kembali: validasi tanggal lalu catat tanggal pengembalian&#xa;Pengguna: Admin, Pengelola, Staff" vertex="1">
          <mxGeometry height="180" width="570" x="670" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="profile" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="PROFIL PENGGUNA&#xa;Lihat dan ubah nama profil&#xa;Ubah kata sandi dengan validasi kata sandi saat ini&#xa;Simpan perubahan atau tampilkan kesalahan validasi&#xa;Pengguna: semua akun yang aktif" vertex="1">
          <mxGeometry height="180" width="570" x="1280" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="users" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="PENGELOLAAN PENGGUNA&#xa;Admin mencari, membuat, mengubah, menonaktifkan, atau menghapus akun&#xa;Validasi email, peran, kata sandi dan konfirmasi&#xa;Cegah hapus/nonaktif akun sendiri dan pertahankan Admin aktif&#xa;Akses di luar izin ditolak (403)" vertex="1">
          <mxGeometry height="180" width="570" x="1890" y="1350" as="geometry" />
        </mxCell>
        <mxCell id="master" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="KATEGORI &amp; LOKASI&#xa;Admin menambah, mengubah, atau menghapus data master&#xa;Validasi nama unik, relasi lokasi induk, dan foto lokasi&#xa;Tolak penghapusan jika masih dipakai aset / memiliki sublokasi&#xa;Akses di luar izin ditolak (403)" vertex="1">
          <mxGeometry height="170" width="570" x="60" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="opname" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="STOK OPNAME&#xa;Admin membuat sesi untuk lokasi atau seluruh aset aktif&#xa;Catat jumlah dan kondisi fisik setiap aset; hitung selisih&#xa;Selesaikan sesi: terapkan penyesuaian stok/kondisi atau simpan hasil saja&#xa;Catat riwayat; tandai item yang perlu ditinjau manual" vertex="1">
          <mxGeometry height="170" width="570" x="670" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="movement" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="MUTASI STOK&#xa;Admin mencatat barang masuk (pembelian) atau keluar (rusak/dibuang)&#xa;Validasi jumlah, tanggal, alasan dan stok tersedia&#xa;Perbarui stok dalam transaksi; sesuaikan status jika stok habis/masuk kembali&#xa;Simpan riwayat aset dan transaksi mutasi" vertex="1">
          <mxGeometry height="170" width="570" x="1280" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="reports" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="RIWAYAT &amp; LAPORAN&#xa;Admin melihat riwayat aset dan memfilter aktivitas&#xa;Pilih laporan aset, peminjaman, opname, atau mutasi&#xa;Validasi filter dan tanggal; tampilkan/cetak atau ekspor PDF, Word, Excel, CSV&#xa;Akses di luar izin ditolak (403)" vertex="1">
          <mxGeometry height="170" width="570" x="1890" y="1590" as="geometry" />
        </mxCell>
        <mxCell id="forgot-password" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="PERMINTAAN RESET KATA SANDI&#xa;Pengguna mengisi email dan pesan opsional&#xa;Validasi dan batasi permintaan per IP/email&#xa;Catat permintaan untuk akun aktif jika belum ada permintaan menunggu" vertex="1">
          <mxGeometry height="130" width="430" x="370" y="360" as="geometry" />
        </mxCell>
        <mxCell id="forgot-confirmation" parent="1" style="shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=13;" value="Tampilkan konfirmasi yang sama&#xa;(status email tidak diungkap)" vertex="1">
          <mxGeometry height="75" width="430" x="370" y="520" as="geometry" />
        </mxCell>
        <mxCell id="reset-review" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="TINJAU PERMINTAAN RESET (ADMIN)&#xa;Periksa identitas; setujui atau tolak&#xa;Proses hanya permintaan menunggu yang belum kedaluwarsa" vertex="1">
          <mxGeometry height="120" width="470" x="1450" y="220" as="geometry" />
        </mxCell>
        <mxCell id="temporary-password" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=13;" value="Permintaan disetujui&#xa;Buat kata sandi sementara, batalkan sesi lain,&#xa;dan tampilkan kata sandi hanya sekali" vertex="1">
          <mxGeometry height="100" width="470" x="1450" y="410" as="geometry" />
        </mxCell>
        <mxCell id="force-password" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=13;align=left;spacingLeft=12;spacingRight=10;" value="WAJIB GANTI KATA SANDI&#xa;Pengguna masuk dengan kata sandi sementara&#xa;Simpan kata sandi baru (min. 8 karakter, terkonfirmasi, dan berbeda)" vertex="1">
          <mxGeometry height="110" width="470" x="1450" y="570" as="geometry" />
