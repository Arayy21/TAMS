        <mxCell id="login" value="Tampilkan halaman login&#xa;Isi email dan kata sandi" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="220" height="70" as="geometry" />
        </mxCell>
        <mxCell id="credentials" value="Input valid, akun aktif,&#xa;dan belum kena batas percobaan?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="610" width="230" height="120" as="geometry" />
        </mxCell>
