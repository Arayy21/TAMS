          <mxGeometry x="80" y="210" width="190" height="60" as="geometry" />
        </mxCell>
        <mxCell id="session" value="Sudah memiliki&#xa;sesi login?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;" vertex="1" parent="1">
