        <mxCell id="logout" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=14;" value="Pilih keluar&#xa;Logout, invalidasi sesi, regenerasi token" vertex="1">
