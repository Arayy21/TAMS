          <mxGeometry x="20" y="790" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="session-regenerate" value="Autentikasi berhasil&#xa;Regenerasi sesi dan catat login terakhir" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=14;" vertex="1" parent="1">
