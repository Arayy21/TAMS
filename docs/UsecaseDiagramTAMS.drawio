        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\r\n    start([Mulai])\r\n    open[Pengguna membuka form peminjaman]\r\n    input[Isi aset, nama peminjam, jumlah, tanggal pinjam, dan batas kembali]\r\n    validate{Data wajib dan format tanggal valid?}\r\n    show_error[/\&quot;Tampilkan kesalahan validasi\&quot;/]\r\n    lock[Mulai transaksi dan kunci baris aset]\r\n    eligible{Aset aktif dan berkondisi baik?}\r\n    available{Jumlah diminta &lt;= jumlah tersedia?}\r\n    reject[/\&quot;Tolak pencatatan dan tampilkan pesan\&quot;/]\r\n    create[Simpan peminjaman]\r\n    commit[Commit transaksi]\r\n    warning{Peminjam masih punya pinjaman terlambat?}\r\n    late_warning[/\&quot;Tampilkan peringatan pinjaman terlambat\&quot;/]\r\n    success[/\&quot;Tampilkan peminjaman berhasil\&quot;/]\r\n    returned{Aset dikembalikan?}\r\n    return_input[Isi tanggal pengembalian]\r\n    return_valid{Tanggal pengembalian valid?}\r\n    return_error[/\&quot;Tampilkan kesalahan tanggal\&quot;/]\r\n    set_return[Simpan tanggal pengembalian]\r\n    finish([Selesai])\r\n\r\n    start --&gt; open --&gt; input --&gt; validate\r\n    validate -- Tidak --&gt; show_error --&gt; input\r\n    validate -- Ya --&gt; lock --&gt; eligible\r\n    eligible -- Tidak --&gt; reject --&gt; finish\r\n    eligible -- Ya --&gt; available\r\n    available -- Tidak --&gt; reject\r\n    available -- Ya --&gt; create --&gt; commit --&gt; warning\r\n    warning -- Ya --&gt; late_warning --&gt; success\r\n    warning -- Tidak --&gt; success\r\n    success --&gt; returned\r\n    returned -- Belum --&gt; finish\r\n    returned -- Ya --&gt; return_input --&gt; return_valid\r\n    return_valid -- Tidak --&gt; return_error --&gt; return_input\r\n    return_valid -- Ya --&gt; set_return --&gt; finish&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="47">
