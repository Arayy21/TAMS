  <diagram name="Flowchart Validasi Peminjaman" id="SxsQI0rq2jC62dD8pr6m">
    <mxGraphModel dx="1935" dy="1128" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\r\n    start([Request POST peminjaman])\r\n    auth{Pengguna masuk dan akun aktif?}\r\n    deny[/\&quot;Tolak akses\&quot;/]\r\n    fields[\&quot;Validasi field: aset, nama, jumlah, tanggal pinjam, batas kembali, catatan\&quot;]\r\n    required{Field wajib terisi dan format sesuai?}\r\n    due{Batas kembali kosong atau &gt;= tanggal pinjam?}\r\n    field_error[/\&quot;Kembali dengan error validasi field\&quot;/]\r\n    transaction[\&quot;Mulai transaksi; kunci baris aset\&quot;]\r\n    exists{Aset ditemukan dan belum dihapus?}\r\n    eligible{Status aktif dan kondisi baik?}\r\n    available[\&quot;Hitung tersedia = jumlah aset - total pinjaman aktif\&quot;]\r\n    enough{Jumlah diminta &lt;= tersedia?}\r\n    save[\&quot;Simpan loan dengan created_by pengguna\&quot;]\r\n    commit[\&quot;Commit transaksi\&quot;]\r\n    fail[/\&quot;Rollback; kembalikan error bisnis tanpa menyimpan\&quot;/]\r\n    response[/\&quot;Redirect sukses; beri peringatan bila ada pinjaman terlambat\&quot;/]\r\n    end([Selesai])\r\n\r\n    start --&gt; auth\r\n    auth -- Tidak --&gt; deny --&gt; end\r\n    auth -- Ya --&gt; fields --&gt; required\r\n    required -- Tidak --&gt; field_error --&gt; end\r\n    required -- Ya --&gt; due\r\n    due -- Tidak --&gt; field_error\r\n    due -- Ya --&gt; transaction --&gt; exists\r\n    exists -- Tidak --&gt; fail --&gt; end\r\n    exists -- Ya --&gt; eligible\r\n    eligible -- Tidak --&gt; fail\r\n    eligible -- Ya --&gt; available --&gt; enough\r\n    enough -- Tidak --&gt; fail\r\n    enough -- Ya --&gt; save --&gt; commit --&gt; response --&gt; end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="41">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;labelBackgroundColor=none;" vertex="1">
