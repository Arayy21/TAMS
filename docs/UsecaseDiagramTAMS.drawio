  <diagram name="Sequence Diagram - Peminjaman" id="bzGY-ohg1VscECXYYwBt">
    <mxGraphModel dx="4838" dy="2819" grid="1" gridSize="10" guides="1" tooltips="0" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\r\n    actor Pengguna\r\n    participant Web as Browser / Form\r\n    participant Middleware as Auth dan akun aktif\r\n    participant Controller as LoanController\r\n    participant DB as Database\r\n\r\n    Pengguna-&gt;&gt;Web: Kirim form POST /peminjam\r\n    Web-&gt;&gt;Middleware: Periksa autentikasi dan status aktif\r\n    Middleware-&gt;&gt;Controller: Teruskan request\r\n    Controller-&gt;&gt;Controller: Validasi field dan format\r\n    alt Validasi field gagal\r\n        Controller--&gt;&gt;Web: Kembali dengan error validasi\r\n        Web--&gt;&gt;Pengguna: Tampilkan error pada form\r\n    else Field valid\r\n        Controller-&gt;&gt;DB: BEGIN TRANSACTION\r\n        Controller-&gt;&gt;DB: SELECT aset FOR UPDATE\r\n        DB--&gt;&gt;Controller: Data aset terkunci\r\n        Controller-&gt;&gt;DB: Hitung unit pinjaman aktif\r\n        DB--&gt;&gt;Controller: Total unit sedang dipinjam\r\n        Controller-&gt;&gt;Controller: Periksa status, kondisi, dan sisa unit\r\n        alt Aset tidak layak atau stok tidak cukup\r\n            Controller-&gt;&gt;DB: ROLLBACK\r\n            Controller--&gt;&gt;Web: Gagal dengan error aset/jumlah\r\n            Web--&gt;&gt;Pengguna: Tampilkan pesan kegagalan\r\n        else Aset layak dan stok cukup\r\n            Controller-&gt;&gt;DB: INSERT loans (termasuk created_by)\r\n            DB--&gt;&gt;Controller: Data peminjaman tersimpan\r\n            Controller-&gt;&gt;DB: COMMIT\r\n            Controller-&gt;&gt;DB: Cari pinjaman terlambat lain milik peminjam\r\n            DB--&gt;&gt;Controller: Jumlah pinjaman terlambat\r\n            Controller--&gt;&gt;Web: Redirect ke daftar peminjaman\r\n            Web--&gt;&gt;Pengguna: Tampilkan sukses dan peringatan jika perlu\r\n        end\r\n    end&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="39">
