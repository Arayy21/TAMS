        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\r\n    USERS {\r\n        bigint id PK\r\n        string name\r\n        string email UK\r\n        string password\r\n        enum role\r\n        boolean is_active\r\n        datetime last_login_at\r\n    }\r\n\r\n    CATEGORIES {\r\n        bigint id PK\r\n        string name UK\r\n        string code_prefix\r\n        string description\r\n    }\r\n\r\n    LOCATIONS {\r\n        bigint id PK\r\n        bigint parent_id FK\r\n        string name\r\n        string description\r\n    }\r\n\r\n    ASSETS {\r\n        bigint id PK\r\n        string asset_code UK\r\n        string name\r\n        bigint category_id FK\r\n        bigint location_id FK\r\n        int quantity\r\n        enum asset_condition\r\n        enum status\r\n        string serial_number\r\n        date purchase_date\r\n        bigint created_by FK\r\n        bigint updated_by FK\r\n        datetime deleted_at\r\n    }\r\n\r\n    LOANS {\r\n        bigint id PK\r\n        bigint asset_id FK\r\n        string borrower_name\r\n        string borrower_contact\r\n        int quantity\r\n        date loaned_at\r\n        date due_at\r\n        date returned_at\r\n        bigint created_by FK\r\n    }\r\n\r\n    STOCK_MOVEMENTS {\r\n        bigint id PK\r\n        bigint asset_id FK\r\n        enum type\r\n        enum reason\r\n        int quantity\r\n        int qty_before\r\n        int qty_after\r\n        date moved_at\r\n        string reference\r\n        bigint created_by FK\r\n    }\r\n\r\n    ASSET_HISTORIES {\r\n        bigint id PK\r\n        bigint asset_id FK\r\n        bigint user_id FK\r\n        enum action\r\n        string field_name\r\n        string old_value\r\n        string new_value\r\n        string notes\r\n        datetime created_at\r\n    }\r\n\r\n    STOCK_OPNAMES {\r\n        bigint id PK\r\n        string code UK\r\n        string name\r\n        date opname_date\r\n        bigint location_id FK\r\n        enum status\r\n        boolean adjustments_applied\r\n        bigint created_by FK\r\n        bigint finished_by FK\r\n        datetime finished_at\r\n    }\r\n\r\n    STOCK_OPNAME_ITEMS {\r\n        bigint id PK\r\n        bigint stock_opname_id FK\r\n        bigint asset_id FK\r\n        int system_qty\r\n        int borrowed_qty\r\n        enum system_condition\r\n        int physical_qty\r\n        enum physical_condition\r\n        bigint checked_by FK\r\n        datetime checked_at\r\n    }\r\n\r\n    CATEGORIES ||--o{ ASSETS : mengelompokkan\r\n    LOCATIONS ||--o{ ASSETS : menempatkan\r\n    LOCATIONS o|--o{ LOCATIONS : memiliki_sub_lokasi\r\n    ASSETS ||--o{ LOANS : dipinjam\r\n    ASSETS ||--o{ STOCK_MOVEMENTS : mengalami_mutasi\r\n    ASSETS ||--o{ ASSET_HISTORIES : memiliki_riwayat\r\n    ASSETS ||--o{ STOCK_OPNAME_ITEMS : diperiksa\r\n    LOCATIONS o|--o{ STOCK_OPNAMES : cakupan_lokasi\r\n    STOCK_OPNAMES ||--o{ STOCK_OPNAME_ITEMS : terdiri_dari\r\n\r\n    USERS o|--o{ ASSETS : membuat\r\n    USERS o|--o{ ASSETS : memperbarui\r\n    USERS o|--o{ LOANS : mencatat\r\n    USERS o|--o{ STOCK_MOVEMENTS : mencatat\r\n    USERS o|--o{ ASSET_HISTORIES : melakukan\r\n    USERS o|--o{ STOCK_OPNAMES : membuat\r\n    USERS o|--o{ STOCK_OPNAMES : menyelesaikan\r\n    USERS o|--o{ STOCK_OPNAME_ITEMS : memeriksa&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="332">
