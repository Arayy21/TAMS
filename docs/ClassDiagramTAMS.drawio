                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\r\n    class User {\r\n        +int id\r\n        +string name\r\n        +string email\r\n        +string role\r\n        +bool is_active\r\n        +isAdmin() bool\r\n        +isPengelola() bool\r\n        +hasActivity() bool\r\n    }\r\n\r\n    class Category {\r\n        +int id\r\n        +string name\r\n        +string code_prefix\r\n        +assets()\r\n    }\r\n\r\n    class Location {\r\n        +int id\r\n        +int parent_id\r\n        +string name\r\n        +parent()\r\n        +children()\r\n        +assets()\r\n    }\r\n\r\n    class Asset {\r\n        +int id\r\n        +string asset_code\r\n        +string name\r\n        +int quantity\r\n        +string asset_condition\r\n        +string status\r\n        +int borrowed\r\n        +int available\r\n        +generateCode() string\r\n        +barcodeSvg() string\r\n    }\r\n\r\n    class Loan {\r\n        +int id\r\n        +int asset_id\r\n        +string borrower_name\r\n        +int quantity\r\n        +date loaned_at\r\n        +date due_at\r\n        +date returned_at\r\n        +scopeActive()\r\n        +bool is_overdue\r\n        +string status_label\r\n    }\r\n\r\n    class StockMovement {\r\n        +int id\r\n        +int asset_id\r\n        +string type\r\n        +string reason\r\n        +int quantity\r\n        +int qty_before\r\n        +int qty_after\r\n        +REASONS\r\n    }\r\n\r\n    class AssetHistory {\r\n        +int id\r\n        +int asset_id\r\n        +int user_id\r\n        +string action\r\n        +string field_name\r\n        +string old_value\r\n        +string new_value\r\n        +string action_label\r\n        +string change_text\r\n    }\r\n\r\n    class StockOpname {\r\n        +int id\r\n        +string code\r\n        +date opname_date\r\n        +string status\r\n        +bool adjustments_applied\r\n        +bool is_running\r\n        +generateCode() string\r\n        +items()\r\n    }\r\n\r\n    class StockOpnameItem {\r\n        +int id\r\n        +int system_qty\r\n        +int borrowed_qty\r\n        +int physical_qty\r\n        +string system_condition\r\n        +string physical_condition\r\n        +bool is_checked\r\n        +int expected_qty\r\n        +int difference\r\n        +string diff_label\r\n    }\r\n\r\n    Category \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Asset : category\r\n    Location \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Asset : location\r\n    Location \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; Location : parent_children\r\n    Asset \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Loan : loans\r\n    Asset \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockMovement : movements\r\n    Asset \&quot;1\&quot; --&gt; \&quot;0..*\&quot; AssetHistory : histories\r\n    Asset \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockOpnameItem : checked_in\r\n    StockOpname \&quot;1\&quot; --&gt; \&quot;0..*\&quot; StockOpnameItem : items\r\n    Location \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; StockOpname : location\r\n    User \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Loan : creator\r\n    User \&quot;0..1\&quot; --&gt; \&quot;0..*\&quot; AssetHistory : user&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="QrBwRw7Ec6dRtCYoXtig-1">
